global
    log /dev/log local0
    maxconn 2048
    daemon

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    timeout connect 5s
    timeout client  30s
    timeout server  30s
    retries 3

frontend http_front
    bind *:80
    default_backend livelink_back

frontend https_front
    bind *:443 ssl crt /etc/letsencrypt/live/www.cholkuol.tech/www.cholkuol.tech.pem
    default_backend livelink_back

backend livelink_back
    balance roundrobin
    server web01 10.227.106.250:80 check
    server web02 10.227.13.33:80 check

listen stats
    bind *:8404
    stats enable
    stats uri /stats
    stats refresh 5s
